# Copy to .env and fill in. Values here are referenced from data/config.yaml as ${NAME},
# so passwords never end up in the config file.

# first camera, used to create config.yaml on the very first start (more cameras: web UI)
RTSP_URL=rtsp://user:password@192.168.1.20:554/stream1

# Home Assistant: long-lived access token from your HA profile -> Security
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# optional basic auth for the web UI
# AUTH_USER=admin
# AUTH_PASSWORD=change-me

# LOG_LEVEL=INFO
